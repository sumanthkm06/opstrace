# ==============================================================================
# OpsTrace - Environment Variables Template
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_USER=opstrace_user
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=opstrace_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Security & Authentication Tokens
# COLLECTOR_API_KEY: Used by Linux collector daemons in Authorization: Bearer <TOKEN>
COLLECTOR_API_KEY=change_collector_token_secret

# ADMIN_API_KEY: Human operator bearer key for protected operator operations
ADMIN_API_KEY=change_admin_token_secret

# Set exact browser origins for cross-origin deployments. Same-origin Nginx
# deployments do not require CORS. Do not use '*' for production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Grafana login (change this value before exposing Grafana beyond localhost)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_grafana_password

# Published host ports
HTTP_PORT=80
GRAFANA_PORT=3000

# Prometheus / Observability
PROMETHEUS_METRICS_ENABLED=true

# ==============================================================================
# Phase 4: Linux Monitoring Collector Settings
# ==============================================================================

# URL of the OpsTrace backend that the collector will send telemetry to.
# Override this to point to your actual backend host/port.
BACKEND_URL=http://localhost:8000

# Interval (in seconds) between telemetry collection cycles.
# Minimum: 5.  Recommended for production: 15–60.
COLLECTION_INTERVAL=30

# Enable/disable systemd service status collection.
# Set to false in environments without systemd (e.g. containers).
COLLECT_SERVICES=true

# ==============================================================================
# Phase 5: Log Collection Settings
# ==============================================================================

# Master switch for log collection.  Set to false to disable all log collection.
COLLECT_LOGS=true

# Comma-separated list of log file paths to monitor.
# Example: /var/log/syslog,/var/log/myapp/application.log
# Leave empty to disable file log collection.
LOG_FILE_PATHS=

# Number of log events to accumulate before sending a batch to the backend.
# Lower values = lower latency; higher values = better throughput.
LOG_BATCH_SIZE=100

# Enable systemd journal collection via journalctl.
# Automatically disabled when journalctl is unavailable (e.g. Windows).
COLLECT_JOURNAL=true

# Number of recent journal entries to fetch on the first collection cycle.
JOURNAL_LINES=200
